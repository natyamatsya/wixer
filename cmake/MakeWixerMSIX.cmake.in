# MSIX Packaging Script using Wixer
# This script uses wixer migrate to generate AppxManifest from WiX YAML sources.
# Exit if not a Windows build.
if(NOT WIN32)
    return()
endif()

# Configuration from CMake
set(WIXER_EXE "@WIXER_EXECUTABLE@")
set(WIX_YAML_SOURCE "@WIX_YAML_SOURCE@")
set(APPX_NAME "@APPX_NAME@")
set(APPX_VERSION "@APPX_VERSION@")
set(ASSETS_DIR "@ASSETS_DIR@")

message(STATUS "=== Wixer MSIX Packaging ===")
message(STATUS "Wixer: ${WIXER_EXE}")
message(STATUS "WiX YAML Source: ${WIX_YAML_SOURCE}")
message(STATUS "AppX Name: ${APPX_NAME}")
message(STATUS "AppX Version: ${APPX_VERSION}")

# Define output file names
set(APPX_PACKAGE_FILE_NAME "${APPX_NAME}-${APPX_VERSION}-x64.msix")
set(APPX_BUNDLE_FILE_NAME "${APPX_NAME}-${APPX_VERSION}.msixbundle")
set(APPX_UPLOAD_FILE_NAME "${APPX_NAME}-${APPX_VERSION}.msixupload")

# Define paths
set(BUNDLE_STAGING_DIR "${CPACK_TOPLEVEL_DIRECTORY}/_bundle_staging")
set(APPX_PACKAGE_FULL_PATH "${BUNDLE_STAGING_DIR}/${APPX_PACKAGE_FILE_NAME}")
set(APPX_BUNDLE_FULL_PATH "${CPACK_TOPLEVEL_DIRECTORY}/${APPX_BUNDLE_FILE_NAME}")
set(APPX_UPLOAD_FULL_PATH "${CPACK_TOPLEVEL_DIRECTORY}/${APPX_UPLOAD_FILE_NAME}")

# Temp directory for wixer migrate output
set(WIXER_MIGRATE_DIR "${CPACK_TOPLEVEL_DIRECTORY}/_wixer_migrate")

## Step 1: Generate AppxManifest using wixer migrate
message(STATUS "Generating AppxManifest from WiX YAML...")
file(MAKE_DIRECTORY "${WIXER_MIGRATE_DIR}")

execute_process(
    COMMAND "${WIXER_EXE}" migrate --target msix "${WIX_YAML_SOURCE}" "${WIXER_MIGRATE_DIR}"
    RESULT_VARIABLE _res_migrate
    OUTPUT_VARIABLE _out_migrate
    ERROR_VARIABLE _err_migrate
)
if(NOT _res_migrate EQUAL 0)
    message(FATAL_ERROR "wixer migrate failed: ${_res_migrate}\n${_err_migrate}")
endif()
message(STATUS "wixer migrate output: ${_out_migrate}")

# Verify AppxManifest was generated
set(GENERATED_MANIFEST "${WIXER_MIGRATE_DIR}/AppxManifest.xml")
if(NOT EXISTS "${GENERATED_MANIFEST}")
    message(FATAL_ERROR "wixer migrate did not generate AppxManifest.xml")
endif()

## Step 2: Prepare staging directory
message(STATUS "Preparing staging directory...")

# Flatten subdirectories (except Assets)
file(GLOB staging_items "${CPACK_TEMPORARY_DIRECTORY}/*")
foreach(item ${staging_items})
    if(IS_DIRECTORY "${item}")
        get_filename_component(dir_name "${item}" NAME)
        string(TOLOWER "${dir_name}" dir_name_lower)
        if(NOT dir_name_lower STREQUAL "assets")
            message(STATUS "Flattening directory: ${item}")
            file(GLOB subdir_contents "${item}/*")
            foreach(subitem ${subdir_contents})
                get_filename_component(subitem_name "${subitem}" NAME)
                file(RENAME "${subitem}" "${CPACK_TEMPORARY_DIRECTORY}/${subitem_name}")
            endforeach()
            file(REMOVE_RECURSE "${item}")
        endif()
    endif()
endforeach()

# Copy generated AppxManifest to staging
file(COPY "${GENERATED_MANIFEST}" DESTINATION "${CPACK_TEMPORARY_DIRECTORY}")
message(STATUS "Copied AppxManifest.xml to staging")

# Copy assets if they exist and aren't already there
if(EXISTS "${ASSETS_DIR}" AND NOT EXISTS "${CPACK_TEMPORARY_DIRECTORY}/Assets")
    file(COPY "${ASSETS_DIR}" DESTINATION "${CPACK_TEMPORARY_DIRECTORY}")
    message(STATUS "Copied Assets directory")
endif()

## Step 3: Find MakeAppx and create package
find_program(MAKEAPPX_EXE MakeAppx.exe
    HINTS "$ENV{ProgramFiles\(x86\)}/Windows Kits/10/bin"
    REQUIRED
)

# Clean and recreate bundle staging
file(REMOVE_RECURSE "${BUNDLE_STAGING_DIR}")
file(MAKE_DIRECTORY "${BUNDLE_STAGING_DIR}")

# Create MSIX package
message(STATUS "Creating MSIX package...")
execute_process(
    COMMAND "${MAKEAPPX_EXE}" pack /d "${CPACK_TEMPORARY_DIRECTORY}" /p "${APPX_PACKAGE_FULL_PATH}" /o
    RESULT_VARIABLE _res_pack
)
if(NOT _res_pack EQUAL 0)
    message(FATAL_ERROR "MakeAppx pack failed: ${_res_pack}")
endif()

# Create bundle
message(STATUS "Creating MSIX bundle...")
execute_process(
    COMMAND "${MAKEAPPX_EXE}" bundle /d "${BUNDLE_STAGING_DIR}" /p "${APPX_BUNDLE_FULL_PATH}" /bv "${APPX_VERSION}" /o
    RESULT_VARIABLE _res_bundle
)
if(NOT _res_bundle EQUAL 0)
    message(FATAL_ERROR "MakeAppx bundle failed: ${_res_bundle}")
endif()

# Copy .msix to output directory
file(COPY "${APPX_PACKAGE_FULL_PATH}" DESTINATION "${CPACK_TOPLEVEL_DIRECTORY}")

# Create upload package (just the bundle for now)
execute_process(
    COMMAND ${CMAKE_COMMAND} -E tar cvf "${APPX_UPLOAD_FULL_PATH}.zip" --format=zip "${APPX_BUNDLE_FULL_PATH}"
    RESULT_VARIABLE _res_zip
)
if(_res_zip EQUAL 0)
    file(RENAME "${APPX_UPLOAD_FULL_PATH}.zip" "${APPX_UPLOAD_FULL_PATH}")
endif()

message(STATUS "=== Wixer MSIX Packaging Complete ===")
message(STATUS "Package: ${APPX_PACKAGE_FULL_PATH}")
message(STATUS "Bundle: ${APPX_BUNDLE_FULL_PATH}")

set(CPACK_EXTERNAL_BUILT_PACKAGES "${APPX_UPLOAD_FULL_PATH}")
