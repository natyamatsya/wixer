# WixerImpersonate.cmake
# Sets up wixer to impersonate wix.exe for transparent YAML support with CMake's WIX generator.
#
# Usage:
#   include(WixerImpersonate)
#   wixer_impersonate(
#       WIXER_EXE "/path/to/wixer.exe"
#       VERBOSE
#       INSPECT_PDB
#       INSPECT_SYMBOLS "symbol1;symbol2"
#       LOG_FILE "/path/to/wixer.log"
#   )
#
# This creates a wix.exe symlink/copy and wixer.yaml config, then sets the WIX
# environment variable so CMake's WIX generator uses wixer transparently.
#
# Options:
#   WIXER_EXE       - Path to wixer executable (auto-detected if not specified)
#   IMPERSONATE_DIR - Directory for impersonation files (default: ${CMAKE_BINARY_DIR}/_wixer_impersonate)
#   VERBOSE         - Enable verbose output from wixer
#   INSPECT_PDB     - Enable PDB inspection after build
#   INSPECT_SYMBOLS - List of symbols to inspect in PDB
#   LOG_FILE        - Path to log file for wixer output (default: ${CMAKE_BINARY_DIR}/wixer.log)
#
# IMPORTANT: CMake's WIX generator caches the WiX path at startup, before any
# config files are processed. You MUST set the WIX environment variable BEFORE
# running cpack:
#
#   PowerShell: . ./build/wixer_env.ps1; cpack -G WIX
#   Bash:       source ./build/wixer_env.sh && cpack -G WIX
#   CMD:        build\wixer_env.cmd && cpack -G WIX
#
# The helper scripts set WIX and WIXER_CONFIG environment variables.
# Debug output is written to ${CMAKE_BINARY_DIR}/wixer.log

function(wixer_impersonate)
    cmake_parse_arguments(ARG
        "VERBOSE;INSPECT_PDB"
        "WIXER_EXE;IMPERSONATE_DIR;LOG_FILE"
        "INSPECT_SYMBOLS"
        ${ARGN}
    )

    if(NOT ARG_WIXER_EXE)
        find_program(ARG_WIXER_EXE wixer)
        if(NOT ARG_WIXER_EXE)
            message(FATAL_ERROR "wixer executable not found. Specify WIXER_EXE or ensure wixer is in PATH.")
        endif()
    endif()

    if(NOT ARG_IMPERSONATE_DIR)
        set(ARG_IMPERSONATE_DIR "${CMAKE_BINARY_DIR}/_wixer_impersonate")
    endif()

    # Find real wix.exe
    find_program(_REAL_WIX_EXE wix
        PATHS
            "C:/Program Files/WiX Toolset v6.0/bin"
            "C:/Program Files/WiX Toolset v5.0/bin"
            "C:/Program Files/WiX Toolset v4.0/bin"
        ENV WIX
    )
    if(NOT _REAL_WIX_EXE)
        message(FATAL_ERROR "wix.exe not found. Install WiX Toolset or set WIX environment variable.")
    endif()

    # Set up impersonation directory (CMake looks in %WIX% and %WIX%\bin)
    file(MAKE_DIRECTORY "${ARG_IMPERSONATE_DIR}")

    # Copy wixer.exe as wix.exe for impersonation (in root and bin for compatibility)
    set(_IMPERSONATE_WIX_EXE "${ARG_IMPERSONATE_DIR}/wix.exe")
    file(COPY_FILE "${ARG_WIXER_EXE}" "${_IMPERSONATE_WIX_EXE}" ONLY_IF_DIFFERENT)
    
    # Also create in bin subdirectory (CMake WIX generator checks both locations)
    file(MAKE_DIRECTORY "${ARG_IMPERSONATE_DIR}/bin")
    file(COPY_FILE "${ARG_WIXER_EXE}" "${ARG_IMPERSONATE_DIR}/bin/wix.exe" ONLY_IF_DIFFERENT)

    # Build wixer.yaml config
    set(_CONFIG_CONTENT "# Auto-generated wixer configuration\n")
    string(APPEND _CONFIG_CONTENT "build:\n")
    string(APPEND _CONFIG_CONTENT "  real_wix_path: \"${_REAL_WIX_EXE}\"\n")

    if(ARG_VERBOSE)
        string(APPEND _CONFIG_CONTENT "  verbose: true\n")
    endif()

    if(ARG_INSPECT_PDB)
        string(APPEND _CONFIG_CONTENT "  inspect_pdb: true\n")
    endif()

    if(ARG_INSPECT_SYMBOLS)
        string(APPEND _CONFIG_CONTENT "  inspect_symbols:\n")
        foreach(_sym ${ARG_INSPECT_SYMBOLS})
            string(APPEND _CONFIG_CONTENT "    - \"${_sym}\"\n")
        endforeach()
    endif()

    # Always enable file logging for debug output (CPack captures stderr)
    set(_LOG_FILE "${ARG_LOG_FILE}")
    if(NOT _LOG_FILE)
        set(_LOG_FILE "${CMAKE_BINARY_DIR}/wixer.log")
    endif()
    string(APPEND _CONFIG_CONTENT "logging:\n")
    string(APPEND _CONFIG_CONTENT "  file: \"${_LOG_FILE}\"\n")

    # Write wixer.yaml config (in both locations for compatibility)
    set(_WIXER_CONFIG "${ARG_IMPERSONATE_DIR}/wixer.yaml")
    file(WRITE "${_WIXER_CONFIG}" "${_CONFIG_CONTENT}")
    file(WRITE "${ARG_IMPERSONATE_DIR}/bin/wixer.yaml" "${_CONFIG_CONTENT}")

    # Set environment variables for current CMake process
    set(ENV{WIXER_CONFIG} "${_WIXER_CONFIG}")
    set(ENV{WIX} "${ARG_IMPERSONATE_DIR}")
    
    # Generate CPack project config to set env vars at CPack runtime
    # This is needed because CPack runs as a separate process
    file(WRITE "${CMAKE_BINARY_DIR}/CPackWixerConfig.cmake" "
# Auto-generated by WixerImpersonate.cmake
# Set WIX environment variable for CPack runtime
set(ENV{WIX} \"${ARG_IMPERSONATE_DIR}\")
set(ENV{WIXER_CONFIG} \"${_WIXER_CONFIG}\")
message(STATUS \"Wixer: WIX env set to \$ENV{WIX}\")
")
    set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_BINARY_DIR}/CPackWixerConfig.cmake" PARENT_SCOPE)

    message(STATUS "Wixer impersonation enabled:")
    message(STATUS "  Wixer: ${ARG_WIXER_EXE}")
    message(STATUS "  Real WiX: ${_REAL_WIX_EXE}")
    message(STATUS "  WIX env: ${ARG_IMPERSONATE_DIR}")
    if(ARG_VERBOSE)
        message(STATUS "  Verbose: ON")
    endif()
    if(ARG_INSPECT_PDB)
        message(STATUS "  Inspect PDB: ON")
    endif()
    if(ARG_INSPECT_SYMBOLS)
        message(STATUS "  Inspect symbols: ${ARG_INSPECT_SYMBOLS}")
    endif()
    message(STATUS "  Log file: ${_LOG_FILE}")
    message(STATUS "  Config: ${_WIXER_CONFIG}")

    # Generate helper scripts to set environment variables for CPack
    # NOTE: CMake checks PATH before WIX env var, so we prepend our bin dir to PATH
    file(WRITE "${CMAKE_BINARY_DIR}/wixer_env.ps1" "# Wixer environment setup for CPack
# Usage: . ./wixer_env.ps1; cpack -G WIX
\$env:WIXER_CONFIG = \"${_WIXER_CONFIG}\"
\$env:WIX = \"${ARG_IMPERSONATE_DIR}\"
# Prepend wixer bin dir to PATH (CMake checks PATH before WIX env var)
\$env:PATH = \"${ARG_IMPERSONATE_DIR}/bin;\$env:PATH\"
Write-Host \"Wixer environment configured:\"
Write-Host \"  WIXER_CONFIG = \$env:WIXER_CONFIG\"
Write-Host \"  WIX = \$env:WIX\"
Write-Host \"  PATH prepended with wixer bin dir\"
")

    file(WRITE "${CMAKE_BINARY_DIR}/wixer_env.sh" "# Wixer environment setup for CPack
# Usage: source ./wixer_env.sh && cpack -G WIX
export WIXER_CONFIG=\"${_WIXER_CONFIG}\"
export WIX=\"${ARG_IMPERSONATE_DIR}\"
# Prepend wixer bin dir to PATH (CMake checks PATH before WIX env var)
export PATH=\"${ARG_IMPERSONATE_DIR}/bin:\$PATH\"
echo \"Wixer environment configured:\"
echo \"  WIXER_CONFIG = \$WIXER_CONFIG\"
echo \"  WIX = \$WIX\"
echo \"  PATH prepended with wixer bin dir\"
")

    file(WRITE "${CMAKE_BINARY_DIR}/wixer_env.cmd" "@echo off
REM Wixer environment setup for CPack
REM Usage: wixer_env.cmd && cpack -G WIX
set WIXER_CONFIG=${_WIXER_CONFIG}
set WIX=${ARG_IMPERSONATE_DIR}
REM Prepend wixer bin dir to PATH (CMake checks PATH before WIX env var)
set PATH=${ARG_IMPERSONATE_DIR}/bin;%PATH%
echo Wixer environment configured:
echo   WIXER_CONFIG = %WIXER_CONFIG%
echo   WIX = %WIX%
echo   PATH prepended with wixer bin dir
")

    # Generate wixer_pack script that runs cpack and shows the log
    file(WRITE "${CMAKE_BINARY_DIR}/wixer_pack.ps1" "# Wixer CPack wrapper with log output
# Usage: ./wixer_pack.ps1 [-Generator WIX]
param(
    [string]\$Generator = \"WIX\"
)

# Set up environment
\$env:WIXER_CONFIG = \"${_WIXER_CONFIG}\"
\$env:WIX = \"${ARG_IMPERSONATE_DIR}\"
\$env:PATH = \"${ARG_IMPERSONATE_DIR}/bin;\$env:PATH\"

# Clear previous log
\$logFile = \"${_LOG_FILE}\"
if (Test-Path \$logFile) { Remove-Item \$logFile }

Write-Host \"========================================\" -ForegroundColor Cyan
Write-Host \"Wixer CPack Build\" -ForegroundColor Cyan
Write-Host \"========================================\" -ForegroundColor Cyan
Write-Host \"\"

# Run CPack
\$result = cpack -G \$Generator
\$exitCode = \$LASTEXITCODE

Write-Host \"\"
Write-Host \"========================================\" -ForegroundColor Cyan
Write-Host \"Wixer Build Log\" -ForegroundColor Cyan
Write-Host \"========================================\" -ForegroundColor Cyan

if (Test-Path \$logFile) {
    Get-Content \$logFile | ForEach-Object {
        if (\$_ -match \"ERROR|WARN\") {
            Write-Host \$_ -ForegroundColor Yellow
        } elseif (\$_ -match \"Running:\") {
            Write-Host \$_ -ForegroundColor Green
        } else {
            Write-Host \$_
        }
    }
} else {
    Write-Host \"No log file found at \$logFile\" -ForegroundColor Yellow
}

Write-Host \"\"
Write-Host \"========================================\" -ForegroundColor Cyan
exit \$exitCode
")

    file(WRITE "${CMAKE_BINARY_DIR}/wixer_pack.sh" "#!/bin/bash
# Wixer CPack wrapper with log output
# Usage: ./wixer_pack.sh [generator]

GENERATOR=\"\${1:-WIX}\"

# Set up environment
export WIXER_CONFIG=\"${_WIXER_CONFIG}\"
export WIX=\"${ARG_IMPERSONATE_DIR}\"
export PATH=\"${ARG_IMPERSONATE_DIR}/bin:\$PATH\"

# Clear previous log
LOG_FILE=\"${_LOG_FILE}\"
rm -f \"\$LOG_FILE\"

echo \"========================================\"
echo \"Wixer CPack Build\"
echo \"========================================\"
echo \"\"

# Run CPack
cpack -G \"\$GENERATOR\"
EXIT_CODE=\$?

echo \"\"
echo \"========================================\"
echo \"Wixer Build Log\"
echo \"========================================\"

if [ -f \"\$LOG_FILE\" ]; then
    cat \"\$LOG_FILE\"
else
    echo \"No log file found at \$LOG_FILE\"
fi

echo \"\"
echo \"========================================\"
exit \$EXIT_CODE
")

    message(STATUS "  Helper scripts: wixer_env.ps1, wixer_pack.ps1")
endfunction()

# wixer_add_yaml_sources(<target> <yaml_source_dir> <output_dir>)
#
# Adds a custom command to export YAML WiX sources to XML before building.
# The exported XML files can then be used with CPACK_WIX_EXTRA_SOURCES or
# as standalone WiX sources.
#
# Arguments:
#   target         - Name for the custom target (e.g., wixer_yaml_export)
#   yaml_source_dir - Directory containing .wxs.yaml, .wxi.yaml, .wxl.yaml files
#   output_dir     - Directory where .wxs, .wxi, .wxl files will be generated
#
# Sets in parent scope:
#   WIXER_YAML_OUTPUT_DIR   - The output directory
#   WIXER_YAML_OUTPUT_FILES - List of generated XML files
#
# Example:
#   set(WIXER_EXECUTABLE "${CMAKE_SOURCE_DIR}/target/release/wixer.exe")
#   wixer_add_yaml_sources(wixer_yaml_export
#       "${CMAKE_SOURCE_DIR}/wix"
#       "${CMAKE_BINARY_DIR}/wix"
#   )
#   # Use with CPack WIX generator:
#   set(CPACK_WIX_EXTRA_SOURCES ${WIXER_YAML_OUTPUT_FILES})
#   # Or build standalone: ninja wixer_yaml_export
#
function(wixer_add_yaml_sources TARGET_NAME YAML_SOURCE_DIR OUTPUT_DIR)
    # Find wixer executable
    if(DEFINED WIXER_EXECUTABLE)
        set(_WIXER_EXE "${WIXER_EXECUTABLE}")
    else()
        find_program(_WIXER_EXE wixer)
        if(NOT _WIXER_EXE)
            message(FATAL_ERROR "wixer executable not found. Set WIXER_EXECUTABLE or ensure wixer is in PATH.")
        endif()
    endif()

    # Glob YAML source files
    file(GLOB_RECURSE _YAML_SOURCES
        "${YAML_SOURCE_DIR}/*.wxs.yaml"
        "${YAML_SOURCE_DIR}/*.wxi.yaml"
        "${YAML_SOURCE_DIR}/*.wxl.yaml"
    )

    if(NOT _YAML_SOURCES)
        message(WARNING "No YAML WiX sources found in ${YAML_SOURCE_DIR}")
        return()
    endif()

    # Create output directory
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")

    # Compute expected output files
    set(_OUTPUT_FILES "")
    foreach(_yaml ${_YAML_SOURCES})
        get_filename_component(_name ${_yaml} NAME)
        # Remove .yaml extension to get .wxs, .wxi, or .wxl
        string(REGEX REPLACE "\\.yaml$" "" _xml_name "${_name}")
        list(APPEND _OUTPUT_FILES "${OUTPUT_DIR}/${_xml_name}")
    endforeach()

    # Add custom command to export YAML to XML
    add_custom_command(
        OUTPUT ${_OUTPUT_FILES}
        COMMAND "${_WIXER_EXE}" export "${YAML_SOURCE_DIR}" "${OUTPUT_DIR}"
        DEPENDS ${_YAML_SOURCES}
        COMMENT "Exporting WiX YAML sources to XML"
        VERBATIM
    )

    # Add custom target that depends on the output files
    add_custom_target(${TARGET_NAME}
        DEPENDS ${_OUTPUT_FILES}
    )

    # Export variables to parent scope
    set(WIXER_YAML_OUTPUT_DIR "${OUTPUT_DIR}" PARENT_SCOPE)
    set(WIXER_YAML_OUTPUT_FILES "${_OUTPUT_FILES}" PARENT_SCOPE)

    message(STATUS "Wixer YAML export configured:")
    message(STATUS "  Source dir: ${YAML_SOURCE_DIR}")
    message(STATUS "  Output dir: ${OUTPUT_DIR}")
    message(STATUS "  Sources: ${_YAML_SOURCES}")
endfunction()

# wixer_msix_package(<yaml_source> [options])
#
# Configures CPack External generator to create MSIX packages using wixer migrate.
# This generates AppxManifest.xml from WiX YAML sources automatically.
#
# Arguments:
#   yaml_source    - Path to the main .wxs.yaml file
#
# Options:
#   APPX_NAME      - Package identity name (default: extracted from YAML)
#   APPX_VERSION   - Package version (default: ${PROJECT_VERSION}.0)
#   ASSETS_DIR     - Directory containing logo assets (default: ${CMAKE_SOURCE_DIR}/assets)
#
# Example:
#   wixer_msix_package("${CMAKE_SOURCE_DIR}/wixer.wxs.yaml"
#       APPX_NAME "Natyamatsya.Wixer"
#       APPX_VERSION "1.0.0.0"
#   )
#
function(wixer_msix_package YAML_SOURCE)
    cmake_parse_arguments(ARG
        ""
        "APPX_NAME;APPX_VERSION;ASSETS_DIR"
        ""
        ${ARGN}
    )

    # Find wixer executable
    if(DEFINED WIXER_EXECUTABLE)
        set(_WIXER_EXE "${WIXER_EXECUTABLE}")
    else()
        find_program(_WIXER_EXE wixer)
        if(NOT _WIXER_EXE)
            message(FATAL_ERROR "wixer executable not found. Set WIXER_EXECUTABLE.")
        endif()
    endif()

    # Set defaults
    if(NOT ARG_APPX_VERSION)
        set(ARG_APPX_VERSION "${PROJECT_VERSION}.0")
    endif()
    if(NOT ARG_ASSETS_DIR)
        set(ARG_ASSETS_DIR "${CMAKE_SOURCE_DIR}/assets")
    endif()
    if(NOT ARG_APPX_NAME)
        # Will be extracted by wixer migrate
        set(ARG_APPX_NAME "${PROJECT_NAME}")
    endif()

    # Store for template substitution
    set(WIXER_EXECUTABLE "${_WIXER_EXE}")
    set(WIX_YAML_SOURCE "${YAML_SOURCE}")
    set(APPX_NAME "${ARG_APPX_NAME}")
    set(APPX_VERSION "${ARG_APPX_VERSION}")
    set(ASSETS_DIR "${ARG_ASSETS_DIR}")

    # Configure the packaging script
    configure_file(
        "${CMAKE_SOURCE_DIR}/cmake/MakeWixerMSIX.cmake.in"
        "${CMAKE_BINARY_DIR}/MakeWixerMSIX.cmake"
        @ONLY
    )

    # Export for use in CMakeLists.txt
    set(WIXER_MSIX_PACKAGE_SCRIPT "${CMAKE_BINARY_DIR}/MakeWixerMSIX.cmake" PARENT_SCOPE)

    message(STATUS "Wixer MSIX packaging configured:")
    message(STATUS "  YAML source: ${YAML_SOURCE}")
    message(STATUS "  APPX name: ${APPX_NAME}")
    message(STATUS "  APPX version: ${APPX_VERSION}")
    message(STATUS "  Assets: ${ASSETS_DIR}")
    message(STATUS "  Script: ${CMAKE_BINARY_DIR}/MakeWixerMSIX.cmake")
endfunction()
