{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Default build configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wixer-rel",
      "displayName": "Wixer Release",
      "description": "Release build with wixer impersonation (legacy MSIX)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WIXER_MSIX_STRATEGY": "legacy"
      }
    },
    {
      "name": "wixer-rel-auto",
      "displayName": "Wixer Release (Auto MSIX)",
      "description": "Release build with auto-generated AppxManifest from YAML",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-auto",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WIXER_MSIX_STRATEGY": "wixer"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "wixer-rel",
      "configurePreset": "wixer-rel"
    },
    {
      "name": "wixer-yaml-export",
      "displayName": "Export YAML to WiX XML",
      "configurePreset": "wixer-rel",
      "targets": ["wixer_yaml_export"]
    },
    {
      "name": "vscode-extension",
      "displayName": "Build VS Code Extension",
      "configurePreset": "wixer-rel",
      "targets": ["build_vscode_extension"]
    }
  ],
  "packagePresets": [
    {
      "name": "wixer-rel-pkg",
      "displayName": "Wixer MSI Package",
      "description": "Build MSI installer using WiX with wixer impersonation",
      "configurePreset": "wixer-rel",
      "generators": ["WIX"],
      "environment": {
        "WIX": "${sourceDir}/build/_wixer_impersonate",
        "WIXER_CONFIG": "${sourceDir}/build/_wixer_impersonate/wixer.yaml",
        "PATH": "${sourceDir}/build/_wixer_impersonate/bin;$penv{PATH}"
      }
    },
    {
      "name": "wixer-rel-msix",
      "displayName": "Wixer MSIX Package (Legacy)",
      "description": "Build MSIX package using pre-configured AppxManifest",
      "configurePreset": "wixer-rel",
      "generators": ["External"]
    },
    {
      "name": "wixer-auto-msix",
      "displayName": "Wixer MSIX Package (Auto)",
      "description": "Build MSIX package with auto-generated AppxManifest from YAML",
      "configurePreset": "wixer-rel-auto",
      "generators": ["External"]
    }
  ],
  "workflowPresets": [
    {
      "name": "wixer-rel-pkg",
      "displayName": "Build & Package MSI",
      "description": "Configure, build VS Code extension, export YAML, and build MSI package",
      "steps": [
        {
          "type": "configure",
          "name": "wixer-rel"
        },
        {
          "type": "build",
          "name": "vscode-extension"
        },
        {
          "type": "build",
          "name": "wixer-yaml-export"
        },
        {
          "type": "package",
          "name": "wixer-rel-pkg"
        }
      ]
    },
    {
      "name": "wixer-auto-msix",
      "displayName": "Build & Package MSIX (Auto)",
      "description": "Configure and build MSIX with auto-generated AppxManifest from YAML",
      "steps": [
        {
          "type": "configure",
          "name": "wixer-rel-auto"
        },
        {
          "type": "package",
          "name": "wixer-auto-msix"
        }
      ]
    }
  ]
}
