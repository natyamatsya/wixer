<?xml version="1.0" encoding="utf-8"?>
<?include PlatformDependentVariables.wxi?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package ProductCode="*" Language="1033" Manufacturer="Acme Corporation" Name="$(var.PlatformProductName)" UpgradeCode="$(var.PlatformUpgradeCode)" Version="1.0.0.0" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>
    <MediaTemplate EmbedCab="yes"/>
    <Directory Id="$(var.PlatformProgramFilesFolder)">
      <Directory Id="INSTALLFOLDER" Name="02_x86_x64_Installer"/>
    </Directory>
    <ComponentGroup Directory="INSTALLFOLDER" Id="ProductComponentGroup">
      <Component Id="cmp_FileToInstall.txt" Guid="*" Bitness="$(var.PlatformBitness)">
        <File KeyPath="yes" Source="FileToInstall.txt"/>
      </Component>
      <Component Id="cmp_my.dll" Guid="*" Bitness="$(var.PlatformBitness)">
        <?if $(var.Platform) = x64?>
        <File KeyPath="yes" Source="my_x64.dll"/>
        <?elseif $(var.Platform) = arm64?>
        <File KeyPath="yes" Source="my_arm64.dll"/>
        <?endif?>
      </Component>
      <Component Id="cmp_RegistryEntry" Guid="*" Bitness="$(var.PlatformBitness)">
        <RegistryKey Root="HKLM" Key="Software\[Manufacturer]\[ProductName]">
          <RegistryValue KeyPath="yes" Type="string" Name="Install location" Value="[INSTALLFOLDER]"/>
        </RegistryKey>
      </Component>
    </ComponentGroup>
    <Feature Id="HelloWorldFeature">
      <ComponentGroupRef Id="ProductComponentGroup"/>
    </Feature>
  </Package>
</Wix>