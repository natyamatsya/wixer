Include:
  xmlns: http://wixtoolset.org/schemas/v4/wxs
  SetProperty:
  - Id: FirstInstall
    After: FindRelatedProducts
    Value: 'true'
    Condition: NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_DOWNGRADE_DETECTED
  - Id: Upgrading
    After: SetFirstInstall
    Value: 'true'
    Condition: 'WIX_UPGRADE_DETECTED AND NOT (REMOVE="ALL")'
  - Id: RemovingForUpgrade
    After: RemoveExistingProducts
    Sequence: execute
    Value: 'true'
    Condition: '(REMOVE="ALL") AND UPGRADINGPRODUCTCODE'
  - Id: Uninstalling
    After: SetUpgrading
    Value: 'true'
    Condition: 'Installed AND (REMOVE="ALL") AND NOT (WIX_UPGRADE_DETECTED OR UPGRADINGPRODUCTCODE)'
  - Id: Maintenance
    After: SetUninstalling
    Value: 'true'
    Condition: Installed AND NOT Upgrading AND NOT Uninstalling AND NOT UPGRADINGPRODUCTCODE
