{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (x64 Release)",
      "description": "Uses CMake's default generator (newest installed Visual Studio), which locates MSVC without a Developer shell",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (x64)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-debug"
    },
    {
      "name": "x86",
      "displayName": "Release (x86)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-x86",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "x86",
      "configurePreset": "x86",
      "configuration": "Release"
    }
  ]
}
