{
  "name": "wixer-vscode",
  "displayName": "Wixer Language Support",
  "description": "Language support for WiX YAML files (.wxs.yaml) using wixer LSP",
  "version": "0.1.0",
  "publisher": "natyamatsya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/natyamatsya/wixer"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:wix-yaml",
    "workspaceContains:**/*.wxs.yaml",
    "workspaceContains:**/*.wxi.yaml",
    "workspaceContains:**/*.wxl.yaml",
    "workspaceContains:**/*.wsi.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "wix-yaml",
        "extensions": [
          ".wxs.yaml",
          ".wxi.yaml",
          ".wxl.yaml",
          ".wsi.yaml"
        ],
        "aliases": [
          "WiX YAML",
          "wixer"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wix-yaml",
        "scopeName": "source.wix.yaml",
        "path": "./syntaxes/wix-yaml.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Wixer",
      "properties": {
        "wixer.executablePath": {
          "type": "string",
          "default": "wixer",
          "description": "Path to the wixer executable. If not absolute, searches PATH."
        },
        "wixer.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the wixer language server."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "wix-yaml",
        "scopes": {
          "class": [
            "entity.name.type.class"
          ],
          "property": [
            "variable.other.property"
          ],
          "string": [
            "string.quoted.double"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && npm run bundle -- --sourcemap",
    "package": "npm run check-types && npm run bundle -- --minify",
    "watch": "npm run bundle -- --sourcemap --watch"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.2",
    "typescript": "^4.9.5",
    "vscode-languageclient": "^8.1.0"
  }
}
