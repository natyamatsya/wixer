{
  "name": "wixer-vscode",
  "displayName": "Wixer Language Support",
  "description": "Language support for WiX YAML files using wixer",
  "version": "0.0.1",
  "publisher": "natyamatsya",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yaml",
        "extensions": [".ywxs", ".ywxs.in", ".ywxi", ".ywxi.in", ".ywxl", ".ywxl.in", ".ywsi", ".ywsi.in"],
        "aliases": ["YAML", "WiX YAML"]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Wixer",
      "properties": {
        "wixer.executablePath": {
          "type": "string",
          "default": "wixer",
          "description": "Path to the wixer executable"
        }
      }
    },
    "semanticTokenScopes": [
        {
            "language": "yaml",
            "scopes": {
                "class": ["entity.name.type.class"],
                "property": ["variable.other.property"],
                "string": ["string.quoted.double"]
            }
        }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^16.11.7",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
